local chams = {}

local function removeCham(plr)
    if chams[plr] then
        pcall(function()
            chams[plr]:Destroy()
        end)
        chams[plr] = nil
    end
end

local function updateCham(plr)
    local character = plr.Character
    local _, hum = getParts(plr)

    local want = togValue("ChamsEnabled", false)
        and character
        and hum
        and hum.Health > 0
        and not (togValue("ChamsTeamCheck", false) and sameTeam(plr))

    if not want then
        removeCham(plr)
        return
    end

    local h = chams[plr]

    if not h or not h.Parent then
        h = Instance.new("Highlight")

        local ok = pcall(function()
            h.Parent = game:GetService("CoreGui")
        end)

        if not ok then
            h.Parent = character
        end

        chams[plr] = h
    end

    h.Adornee = character
    h.FillColor = optValue("ChamsFill", Color3.fromRGB(170, 85, 255))
    h.OutlineColor = optValue("ChamsOutline", Color3.fromRGB(255, 255, 255))
    h.FillTransparency = optValue("ChamsFillTrans", 0.5)
    h.OutlineTransparency = optValue("ChamsOutlineTrans", 0)
    h.DepthMode = togValue("ChamsWalls", true)
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded
end

-- Player visuals (Drawing) --------------------------------------

local R15_BONES = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}

local R6_BONES = {
    { "Head", "Torso" }, { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
    { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
}

local visDrawings = {}

local function newLine(thickness)
    local l = Drawing.new("Line")
    l.Thickness = thickness or 1
    l.Visible = false
    return l
end

local function getVis(plr)
    if visDrawings[plr] then
        return visDrawings[plr]
    end

    local d = {
        HealthBack = newLine(4),
        HealthBar = newLine(2),
        HealthText = Drawing.new("Text"),
        Tool = Drawing.new("Text"),
        Dot = Drawing.new("Circle"),
        Skel = {},
    }

    d.HealthText.Size = 12
    d.HealthText.Center = true
    d.HealthText.Outline = true
    d.HealthText.Visible = false

    d.Tool.Size = 13
    d.Tool.Center = true
    d.Tool.Outline = true
    d.Tool.Visible = false

    d.Dot.NumSides = 24
    d.Dot.Thickness = 1.5
    d.Dot.Filled = false
    d.Dot.Visible = false

    for i = 1, 14 do
        d.Skel[i] = newLine(1.5)
    end

    d.HealthBack.Color = Color3.new(0, 0, 0)

    visDrawings[plr] = d
    return d
end

local function hideVis(d)
    d.HealthBack.Visible = false
    d.HealthBar.Visible = false
    d.HealthText.Visible = false
    d.Tool.Visible = false
    d.Dot.Visible = false

    for _, l in ipairs(d.Skel) do
        l.Visible = false
    end
end

local function removeVis(plr)
    local d = visDrawings[plr]
    if not d then
        return
    end

    pcall(function()
        d.HealthBack:Remove()
        d.HealthBar:Remove()
        d.HealthText:Remove()
        d.Tool:Remove()
        d.Dot:Remove()

        for _, l in ipairs(d.Skel) do
            l:Remove()
        end
    end)

    visDrawings[plr] = nil
end

local function updateVis(plr, cam, myRoot)
    local d = getVis(plr)
    local root, hum = getParts(plr)
    local character = plr.Character

    local anyOn = togValue("VisHealthBar", false)
        or togValue("VisHealthText", false)
        or togValue("VisSkeleton", false)
        or togValue("VisHeadDot", false)
        or togValue("VisTool", false)

    if not anyOn or not root or not hum or hum.Health <= 0 or not myRoot
        or (togValue("VisTeamCheck", false) and sameTeam(plr)) then
        hideVis(d)
        return
    end

    local distance = (root.Position - myRoot.Position).Magnitude
    local pos, onScreen = cam:WorldToViewportPoint(root.Position)

    if not onScreen or pos.Z <= 0 or distance > CFG.EspMaxDistance then
        hideVis(d)
        return
    end

    local head = character:FindFirstChild("Head")
    local headPos = head
        and cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        or pos

    local boxHeight = math.max(math.abs(headPos.Y - pos.Y) * 2, 10)
    local boxWidth = boxHeight * 0.65

    local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    local hpColor = Color3.fromRGB(255 * (1 - frac), 255 * frac, 0)

    local left = pos.X - boxWidth / 2 - 5
    local bottom = pos.Y + boxHeight / 2
    local top = bottom - boxHeight

    -- health bar
    if togValue("VisHealthBar", false) then
        d.HealthBack.From = Vector2.new(left, bottom + 1)
        d.HealthBack.To = Vector2.new(left, top - 1)
        d.HealthBack.Visible = true

        d.HealthBar.From = Vector2.new(left, bottom)
        d.HealthBar.To = Vector2.new(left, bottom - boxHeight * frac)
        d.HealthBar.Color = hpColor
        d.HealthBar.Visible = true
    else
        d.HealthBack.Visible = false
        d.HealthBar.Visible = false
    end

    -- health text
    if togValue("VisHealthText", false) then
        d.HealthText.Text = tostring(math.floor(hum.Health))
        d.HealthText.Position = Vector2.new(left - 14, bottom - boxHeight * frac - 6)
        d.HealthText.Color = hpColor
        d.HealthText.Visible = true
    else
        d.HealthText.Visible = false
    end

    -- held tool
    local tool = character:FindFirstChildOfClass("Tool")

    if togValue("VisTool", false) and tool then
        d.Tool.Text = tool.Name
        d.Tool.Position = Vector2.new(pos.X, bottom + 2)
        d.Tool.Color = Color3.fromRGB(255, 255, 255)
        d.Tool.Visible = true
    else
        d.Tool.Visible = false
    end

    -- head circle
    if togValue("VisHeadDot", false) and head then
        local hp = cam:WorldToViewportPoint(head.Position)

        d.Dot.Position = Vector2.new(hp.X, hp.Y)
        d.Dot.Radius = math.max(boxHeight * 0.09, 3)
        d.Dot.Color = optValue("VisSkeletonColor", Color3.new(1, 1, 1))
        d.Dot.Visible = true
    else
        d.Dot.Visible = false
    end

    -- skeleton
    if togValue("VisSkeleton", false) then
        local bones = character:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
        local color = optValue("VisSkeletonColor", Color3.new(1, 1, 1))

        for i, line in ipairs(d.Skel) do
            local pair = bones[i]
            local a = pair and character:FindFirstChild(pair[1])
            local b = pair and character:FindFirstChild(pair[2])

            if a and b then
                local pa, va = cam:WorldToViewportPoint(a.Position)
                local pb, vb = cam:WorldToViewportPoint(b.Position)

                if va and vb then
                    line.From = Vector2.new(pa.X, pa.Y)
                    line.To = Vector2.new(pb.X, pb.Y)
                    line.Color = color
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
    else
        for _, line in ipairs(d.Skel) do
            line.Visible = false
        end
    end
end

-- Crosshair -----------------------------------------------------

local crossLines = {}

for i = 1, 4 do
    local l = Drawing.new("Line")
    l.Visible = false
    crossLines[i] = l
end

local function updateCrosshair(cam)
    if not togValue("CrossEnabled", false) then
        for _, l in ipairs(crossLines) do
            l.Visible = false
        end
        return
    end

    local c = cam.ViewportSize / 2
    local size = optValue("CrossSize", 8)
    local gap = optValue("CrossGap", 4)
    local thickness = optValue("CrossThickness", 2)
    local color = optValue("CrossColor", Color3.fromRGB(0, 255, 0))

    local segments = {
        { Vector2.new(c.X - gap - size, c.Y), Vector2.new(c.X - gap, c.Y) },
        { Vector2.new(c.X + gap, c.Y), Vector2.new(c.X + gap + size, c.Y) },
        { Vector2.new(c.X, c.Y - gap - size), Vector2.new(c.X, c.Y - gap) },
        { Vector2.new(c.X, c.Y + gap), Vector2.new(c.X, c.Y + gap + size) },
    }

    for i, l in ipairs(crossLines) do
        l.From = segments[i][1]
        l.To = segments[i][2]
        l.Thickness = thickness
        l.Color = color
        l.Visible = true
    end
end

