local espDrawings = {}

local function createEsp(plr)
    if espDrawings[plr] then
        return
    end

    local drawings = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Tracer = Drawing.new("Line")
    }

    drawings.Box.Thickness = 1.5
    drawings.Box.Filled = false
    drawings.Box.Visible = false

    drawings.Name.Size = 14
    drawings.Name.Center = true
    drawings.Name.Outline = true
    drawings.Name.Visible = false

    drawings.Tracer.Thickness = 1.5
    drawings.Tracer.Visible = false

    espDrawings[plr] = drawings
end

local function removeEsp(plr)
    if not espDrawings[plr] then
        return
    end

    for _, drawing in pairs(espDrawings[plr]) do
        drawing:Remove()
    end

    espDrawings[plr] = nil
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= player then
        createEsp(p)
    end
end

connections[#connections + 1] = Players.PlayerAdded:Connect(function(p)
    if p ~= player then
        createEsp(p)
    end
end)

connections[#connections + 1] = Players.PlayerRemoving:Connect(removeEsp)

connections[#connections + 1] = RunService.RenderStepped:Connect(function()
    camera = workspace.CurrentCamera

    for plr, drawings in pairs(espDrawings) do
        local root, hum = getParts(plr)
        local myRoot = getParts(player)

        if CFG.EspEnabled and root and hum
            and hum.Health > 0 and myRoot then

            local distance = (root.Position - myRoot.Position).Magnitude
            local pos, onScreen = camera:WorldToViewportPoint(root.Position)

            if onScreen and distance <= CFG.EspMaxDistance then
                local head = plr.Character and plr.Character:FindFirstChild("Head")

                local headPos = head
                    and camera:WorldToViewportPoint(
                        head.Position + Vector3.new(0, 0.5, 0)
                    )
                    or pos

                local boxHeight = math.abs(headPos.Y - pos.Y) * 2
                local boxWidth = boxHeight * 0.65

                if CFG.EspBoxes then
                    drawings.Box.Size = Vector2.new(boxWidth, boxHeight)

                    drawings.Box.Position = Vector2.new(
                        pos.X - boxWidth / 2,
                        pos.Y - boxHeight / 2
                    )

                    drawings.Box.Color = CFG.EspColor
                    drawings.Box.Visible = true
                else
                    drawings.Box.Visible = false
                end

                if CFG.EspNames then
                    local text = plr.Name

                    if CFG.EspDistance then
                        text = text .. string.format(
                            " [%dM]", math.floor(distance)
                        )
                    end

                    drawings.Name.Text = text

                    drawings.Name.Position = Vector2.new(
                        pos.X,
                        pos.Y - boxHeight / 2 - 16
                    )

                    drawings.Name.Color = CFG.EspColor
                    drawings.Name.Visible = true
                else
                    drawings.Name.Visible = false
                end

                if CFG.EspTracers then
                    drawings.Tracer.From = Vector2.new(
                        camera.ViewportSize.X / 2,
                        camera.ViewportSize.Y
                    )

                    drawings.Tracer.To = Vector2.new(pos.X, pos.Y)
                    drawings.Tracer.Color = CFG.EspColor
                    drawings.Tracer.Visible = true
                else
                    drawings.Tracer.Visible = false
                end
            else
                drawings.Box.Visible = false
                drawings.Name.Visible = false
                drawings.Tracer.Visible = false
            end
        else
            drawings.Box.Visible = false
            drawings.Name.Visible = false
            drawings.Tracer.Visible = false
        end
    end
end)

