local fxOrig = {}       -- [PostEffect] = Enabled
local atmoOrig = {}     -- [Atmosphere] = {Density, Haze}
local cloudsOrig = {}   -- [Clouds] = Enabled

local function setWorldFx(state)
    if state then
        for _, c in ipairs(Lighting:GetChildren()) do
            if c:IsA("PostEffect") and fxOrig[c] == nil then
                fxOrig[c] = c.Enabled
                c.Enabled = false
            elseif c:IsA("Atmosphere") and atmoOrig[c] == nil then
                atmoOrig[c] = { c.Density, c.Haze }
                c.Density = 0
                c.Haze = 0
            end
        end

        local terrain = workspace:FindFirstChildOfClass("Terrain")
        local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")

        if clouds and cloudsOrig[clouds] == nil then
            cloudsOrig[clouds] = clouds.Enabled
            clouds.Enabled = false
        end
    else
        for c, v in pairs(fxOrig) do
            pcall(function() c.Enabled = v end)
        end
        for c, v in pairs(atmoOrig) do
            pcall(function() c.Density = v[1] c.Haze = v[2] end)
        end
        for c, v in pairs(cloudsOrig) do
            pcall(function() c.Enabled = v end)
        end

        fxOrig, atmoOrig, cloudsOrig = {}, {}, {}
    end
end

