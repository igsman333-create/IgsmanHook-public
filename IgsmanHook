local function jit(value)
    local j = math.clamp(CFG.VoidJitter, 0, 0.9)
    return value * (1 + (math.random() * 2 - 1) * j)
end

local function voidCFrame(pos)
    local spread = CFG.VoidSpread
    return CFrame.new(
        pos.X + (spread > 0 and math.random(-spread, spread) or 0),
        CFG.VoidHeight,
        pos.Z + (spread > 0 and math.random(-spread, spread) or 0)
    )
end

