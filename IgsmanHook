-- AURA KILL (Main)
-- Teleport do dowolnego gracza, klikanie, latanie za nim (XYZ 0).
-- Gdy cel ma <= progu HP (np. 5 / 2) lub zginie, przeskakuje na
-- kolejnego gracza i tak w kółko.
----------------------------------------------------------------

local AuraBox = Tabs.Main:AddLeftGroupbox('Aura Kill')
local AuraSettingsBox = Tabs.Main:AddRightGroupbox('Aura Kill Settings')

local auraConn = nil
local auraTarget = nil
local auraSkip = {}        -- [Player] = czas do kiedy gracz jest pomijany
local auraListIndex = 0
local auraLastClick = 0

local auraTargetLabel = AuraBox:AddLabel('Target: -')

local function auraCandidates(myRoot)
    local list = {}
    local now = os.clock()
    local threshold = optValue("AuraHp", 5)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local root, hum = getParts(plr)
            local skipUntil = auraSkip[plr]

            if root and hum and hum.Health > threshold
                and not (skipUntil and now < skipUntil)
                and not (togValue("AuraTeamCheck", false) and sameTeam(plr)) then
                list[#list + 1] = plr
            end
        end
    end

    return list
end

local function auraPick(myRoot)
    local list = auraCandidates(myRoot)

    if #list == 0 then
        return nil
    end

    local mode = optValue("AuraMode", "Nearest")

    if mode == "Random" then
        return list[math.random(1, #list)]
    elseif mode == "Next in list" then
        auraListIndex = (auraListIndex % #list) + 1
        return list[auraListIndex]
    end

    -- Nearest
    local best, bestDist = nil, math.huge

    for _, plr in ipairs(list) do
        local root = getParts(plr)
        local dist = (root.Position - myRoot.Position).Magnitude

        if dist < bestDist then
            best, bestDist = plr, dist
        end
    end

    return best
end

local function auraStep()
    if enabled then
        return -- Rage ma pierwszeństwo
    end

    local myRoot, myHum = getParts(player)

    if not myRoot or not myHum or myHum.Health <= 0 then
        return
    end

    local now = os.clock()
    local threshold = optValue("AuraHp", 5)

    -- sprawdź obecny cel
    if auraTarget then
        local tRoot, tHum = getParts(auraTarget)

        if not auraTarget.Parent or not tRoot or not tHum or tHum.Health <= 0 then
            auraTarget = nil
        elseif tHum.Health <= threshold then
            -- cel ma mało HP: zostaw go i leć do następnego
            auraSkip[auraTarget] = now + optValue("AuraSkipTime", 5)
            auraTarget = nil
        end
    end

    if not auraTarget then
        auraTarget = auraPick(myRoot)
    end

    if not auraTarget then
        auraTargetLabel:SetText('Target: -')
        return
    end

    local tRoot, tHum = getParts(auraTarget)

    if not tRoot or not tHum then
        auraTarget = nil
        return
    end

    auraTargetLabel:SetText(string.format(
        'Target: %s (%d HP)', auraTarget.Name, math.floor(tHum.Health)
    ))

    myHum.PlatformStand = true
    equipTool()

    -- lot za graczem, XYZ offset = 0 (opcjonalnie wysokość)
    myRoot.CFrame = CFrame.new(
        tRoot.Position + Vector3.new(0, optValue("AuraHeight", 0), 0)
    )
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero

    if togValue("AuraSpectate", false) and spectatedHum ~= tHum then
        local cam = workspace.CurrentCamera
        cam.CameraType = Enum.CameraType.Custom
        cam.CameraSubject = tHum
        spectatedHum = tHum
    end

    if now - auraLastClick >= optValue("AuraClickDelay", 0.1) then
        auraLastClick = now
        clickTool()
    end
end

local function stopAura()
    if auraConn then
        auraConn:Disconnect()
        auraConn = nil
    end

    auraTarget = nil
    auraSkip = {}
    auraTargetLabel:SetText('Target: -')

    if not enabled then
        local _, hum = getParts(player)

        if hum and not CFG.FlyEnabled then
            hum.PlatformStand = false
        end

        resetCamera()
    end
end

local function startAura()
    stopAura()

    -- Rage i Aura Kill nie mogą działać razem
    if Toggles.RageEnabled and Toggles.RageEnabled.Value then
        Toggles.RageEnabled:SetValue(false)
    end

    auraConn = RunService.Heartbeat:Connect(function()
        local ok, err = pcall(auraStep)

        if not ok then
            warn("[IgsmanHook] Aura Kill error: " .. tostring(err))
        end
    end)
end

