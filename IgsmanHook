local savedLocations = {}   -- [nazwa] = CFrame
local savedOrder = {}       -- kolejność nazw (do dropdowna)

local function locNames()
    if #savedOrder == 0 then
        return { "Brak lokacji" }
    end
    return savedOrder
end

local function refreshLocations()
    if Options.LocSelected then
        Options.LocSelected:SetValues(locNames())
        Options.LocSelected:SetValue(locNames()[1])
    end
end

local function teleportToCFrame(cf)
    local root = getParts(player)
    if not root then
        Library:Notify('Brak postaci', 3)
        return
    end

    root.CFrame = cf
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

local function saveLocation(cf)
    local name = Options.LocName.Value
    if not name or name:gsub("%s", "") == "" then
        name = "Loc " .. (#savedOrder + 1)
    end

    if not savedLocations[name] then
        table.insert(savedOrder, name)
    end
    savedLocations[name] = cf

    refreshLocations()
    Options.LocSelected:SetValue(name)
    Library:Notify('Zapisano: ' .. name, 3)
end

