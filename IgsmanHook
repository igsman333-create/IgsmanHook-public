local function getParts(plr)
    local character = plr and plr.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    return root, humanoid
end

local function getPlayerNames()
    local list = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(list, p.Name)
        end
    end

    if #list == 0 then
        table.insert(list, "Brak graczy")
    end

    return list
end

local function updatePlayerList()
    if Options and Options.TargetPlayer then
        Options.TargetPlayer:SetValues(getPlayerNames())
    end
end

local function getSelectedTarget()
    if not Options or not Options.TargetPlayer then
        return nil
    end

    local targetName = Options.TargetPlayer.Value

    if targetName and targetName ~= "Brak graczy" then
        return Players:FindFirstChild(targetName)
    end

    return nil
end

local function forceFarTeleport(root, dist)
    if not root or not root.Parent then
        return
    end

    local distance = dist or CFG.AntiKillDistance

    local randX = math.random(-distance, distance)
    local randZ = math.random(-distance, distance)

    root.CFrame = CFrame.new(randX, 500000, randZ)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

local function randomTeleport(root, customArea)
    if not root or not root.Parent then
        return
    end

    local area = customArea or CFG.RandomArea

    root.CFrame = CFrame.new(
        math.random(-area, 10000), -- X
        0,                         -- Y
        math.random(-area, 10000)  -- Z
    )

    root.AssemblyLinearVelocity = Vector3.zero
end

local function randomPointInSphere(radius, surfaceOnly)
    local v

    repeat
        v = Vector3.new(
            math.random() * 2 - 1,
            math.random() * 2 - 1,
            math.random() * 2 - 1
        )
    until v.Magnitude > 0.01 and v.Magnitude <= 1

    local direction = v.Unit

    if surfaceOnly then
        return direction * radius
    end

    return direction * radius * (math.random() ^ (1 / 3))
end

local function equipTool()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChildOfClass("Backpack")

    if not humanoid or not backpack then
        return
    end

    if character:FindFirstChildOfClass("Tool") then
        return
    end

    local tool = backpack:FindFirstChildOfClass("Tool")

    if tool then
        humanoid:EquipTool(tool)
    end
end

local function clickTool()
    local character = player.Character
    local tool = character and character:FindFirstChildOfClass("Tool")

    if tool then
        tool:Activate()
    end
end

local function resetCamera()
    camera = workspace.CurrentCamera
    local _, humanoid = getParts(player)

    camera.CameraType = Enum.CameraType.Custom

    if humanoid then
        camera.CameraSubject = humanoid
    end

    spectatedHum = nil
end

