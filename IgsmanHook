local function isCharacterPart(part)
    local model = part:FindFirstAncestorOfClass("Model")
    return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

local xrayOrig = setmetatable({}, { __mode = "k" })
local plasticOrig = setmetatable({}, { __mode = "k" })
local xrayGen, plasticGen = 0, 0
local xrayValue = 0.6

WMapBox:AddToggle('WXray', {
    Text = 'X-Ray',
    Default = false,
    Tooltip = 'Półprzezroczyste ściany i obiekty mapy',
}):OnChanged(function()
    xrayGen = xrayGen + 1
    local gen = xrayGen

    if Toggles.WXray.Value then
        task.spawn(function()
            local n = 0

            for _, d in ipairs(workspace:GetDescendants()) do
                if gen ~= xrayGen then
                    return
                end

                if d:IsA("BasePart") and d.Transparency < xrayValue and not isCharacterPart(d) then
                    xrayOrig[d] = d.Transparency
                    d.Transparency = xrayValue
