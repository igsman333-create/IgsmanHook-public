local function toggleAntiKill(state)
    CFG.AntiKill = state

    if antiKillConn then
        antiKillConn:Disconnect()
        antiKillConn = nil
    end

    if state then
        antiKillConn = RunService.Heartbeat:Connect(function()
            if not CFG.AntiKill then
                return
            end

            local myRoot, myHum = getParts(player)

            if myRoot and myHum and myHum.Health > 0 then
                forceFarTeleport(myRoot, CFG.AntiKillDistance)
            end
        end)
    end
end

