local function stop()
    enabled = false
    runId = runId + 1
    voidCF = nil
    lowHpTeleported = false
    sphereStart = nil
    lastTargetHum = nil
    voidPhaseEnd = nil
    voidPhase = "player"
    damageVoidUntil = 0
    lastHp = nil

    if conn then
        conn:Disconnect()
        conn = nil
    end

    local _, myHum = getParts(player)

    if myHum then
        myHum.PlatformStand = false
    end

    resetCamera()
end

----------------------------------------------------------------
-- START / RAGE
----------------------------------------------------------------

local function start()
    if enabled then
        return
    end

    enabled = true
    lowHpTeleported = false
    runId = runId + 1
    voidCF = nil

    local myRun = runId

    equipTool()

    task.spawn(function()
        local startTime = os.clock()

        while enabled and runId == myRun and os.clock() - startTime < 2.4 do
            local myRoot, myHum = getParts(player)

            if myRoot and myHum and myHum.Health > 0 then
                myHum.PlatformStand = true
                equipTool()
                randomTeleport(myRoot)
            end

            task.wait()
        end

        if not enabled or runId ~= myRun then
            return
        end

        nextTeleport = 0
        sphereStart = os.clock()
        lastTargetHum = nil
        voidPhaseEnd = nil
        voidPhase = "player"
        damageVoidUntil = 0
        lastHp = nil

        conn = RunService.Heartbeat:Connect(function()
            camera = workspace.CurrentCamera

            local myRoot, myHum = getParts(player)

            -- Najpierw sprawdzamy, czy postać istnieje.
            if not myRoot or not myHum or myHum.Health <= 0 then
                return
            end

            -- wykrywanie obrażeń (ucieczka w skybox)
            if lastHp and myHum.Health < lastHp - 0.01 and CFG.DamageVoid then
                damageVoidUntil = os.clock() + CFG.DamageVoidTime
            end
            lastHp = myHum.Health

            ----------------------------------------------------
            -- LOW HP RANDOM TP
            -- Teleport przy 10 HP lub mniej, tylko raz.
            ----------------------------------------------------

            if CFG.LowHpEnabled and myHum.Health <= CFG.LowHpThreshold then
                if not lowHpTeleported then
                    lowHpTeleported = true

                    -- losowy tp w skybox (hide void)
                    myRoot.CFrame = voidCFrame(myRoot.Position)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero

                    -- wyłącz rage
                    task.defer(function()
                        if Toggles.RageEnabled then
                            Toggles.RageEnabled:SetValue(false)
                        end
                    end)
                end

                return
            else
                -- Można ponownie aktywować po wzroście HP powyżej 10.
                lowHpTeleported = false
            end

            myHum.PlatformStand = true
            equipTool()

            local target = getSelectedTarget()

            if not target or not target.Parent then
                return
            end

            local targetRoot, targetHum = getParts(target)

            if not targetRoot or not targetHum or targetHum.Health <= 0 then
                randomTeleport(myRoot)
                return
            end

            if spectatedHum ~= targetHum then
                camera.CameraType = Enum.CameraType.Custom
                camera.CameraSubject = targetHum
                spectatedHum = targetHum
            end

            -- reset odliczania przy nowym celu / respawnie
            if lastTargetHum ~= targetHum then
                lastTargetHum = targetHum
                sphereStart = os.clock()
            end

            local now = os.clock()

            local centered = CFG.CenterEnabled
                and sphereStart
                and (now - sphereStart >= CFG.CenterAfter)

            local hiding = CFG.DamageVoid and now < damageVoidUntil

            if hiding then
                -- dostałeś obrażenia: uciekasz w skybox
                if not voidCF then
                    voidCF = voidCFrame(targetRoot.Position)
                end

                myRoot.CFrame = voidCF
            elseif centered then
                -- po CenterAfter sek: lot prosto do gracza, XYZ offset = 0
                if CFG.VoidSpam then
                    if not voidPhaseEnd then
                        voidPhase = "player"
                        voidPhaseEnd = now + jit(CFG.VoidInterval)
                    elseif now >= voidPhaseEnd then
                        if voidPhase == "player" then
                            voidPhase = "void"
                            voidCF = nil
                            voidPhaseEnd = now + jit(CFG.VoidDuration)
                        else
                            voidPhase = "player"
                            voidCF = nil
                            voidPhaseEnd = now + jit(CFG.VoidInterval)
                        end
                    end
                else
                    voidPhase = "player"
                    voidPhaseEnd = nil
                end

                if CFG.VoidSpam and voidPhase == "void" then
                    if not voidCF then
                        voidCF = voidCFrame(targetRoot.Position)
                    end

                    myRoot.CFrame = voidCF
                else
                    voidCF = nil
                    myRoot.CFrame = CFrame.new(targetRoot.Position)
                end
            else
                voidPhaseEnd = nil
                voidPhase = "player"
                voidCF = nil

                if now >= nextTeleport then
                    nextTeleport = now + CFG.TeleportDelay

                    sphereOffset = randomPointInSphere(
                        CFG.SphereRadius,
                        CFG.SurfaceOnly
                    )
                end

                myRoot.CFrame = CFrame.lookAt(
                    targetRoot.Position + sphereOffset,
                    targetRoot.Position
                )
            end

            myRoot.AssemblyLinearVelocity = Vector3.zero

            if os.clock() - lastClick >= CFG.ClickDelay then
                lastClick = os.clock()
                clickTool()
            end
        end)
    end)
end

