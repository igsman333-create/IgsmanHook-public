local Camera = Workspace.CurrentCamera

-- Ustawienia czytane na żywo z UI (Toggles / Options).
local function optValue(name, default)
    local o = Options and Options[name]
    if o ~= nil and o.Value ~= nil then
        return o.Value
    end
    return default
end

local function togValue(name, default)
    local t = Toggles and Toggles[name]
    if t ~= nil then
        return t.Value
    end
    return default
end

local function aimKeyHeld()
    if togValue("AimAlways", false) then
        return true
    end

    local key = Options and Options.AimKey
    if not key then
        return false
    end

    local ok, state = pcall(function()
        return key:GetState()
    end)

    return ok and state == true
end

local function sameTeam(plr)
    -- Team check działa tylko, gdy w grze są min. 2 drużyny
    if LocalPlayer.Team == nil or plr.Team == nil then
        return false
    end

    if #Teams:GetTeams() < 2 then
        return false
    end

    return plr.Team == LocalPlayer.Team
end

local function getAimPart(character)
    local wanted = optValue("TargetPart", "Head")

    return character:FindFirstChild(wanted)
        or character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
end

-- Raycast, który ignoruje przezroczyste / niekolizyjne części
local function isVisible(part, character)
    local origin = Camera.CFrame.Position
    local ignore = { character, Camera }

    if LocalPlayer.Character then
        table.insert(ignore, LocalPlayer.Character)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    for _ = 1, 10 do
        params.FilterDescendantsInstances = ignore

        local hit = Workspace:Raycast(origin, part.Position - origin, params)

        if not hit then
            return true
        end

        local inst = hit.Instance

        if inst.Transparency >= 0.9 or not inst.CanCollide then
            table.insert(ignore, inst)
            origin = hit.Position
        else
            return false
        end
    end

    return false
end

local function getClosestTarget(fov, aimPoint)
    local closestPart = nil
    local closestScreen = nil
    local closestDistance = fov

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer
            and not (togValue("TeamCheck", true) and sameTeam(plr)) then

            local character = plr.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local part = character and getAimPart(character)

            if humanoid and humanoid.Health > 0 and part then
                local screenPoint, onScreen =
                    Camera:WorldToScreenPoint(part.Position)

                if onScreen then
                    local pos = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distance = (pos - aimPoint).Magnitude

                    if distance < closestDistance
                        and (not togValue("VisibilityCheck", true)
                            or isVisible(part, character)) then

                        closestDistance = distance
                        closestPart = part
                        closestScreen = pos
                    end
                end
            end
        end
    end

    return closestPart, closestScreen
end

-- FOV circle
local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5
fovCircle.NumSides = 64
fovCircle.Filled = false
fovCircle.Color = Color3.fromRGB(255, 255, 255)
fovCircle.Visible = false

local aimErrorShown = false

local function aimbotStep(deltaTime)
    Camera = Workspace.CurrentCamera
    if not Camera then
        return
    end

    local aimEnabled = togValue("AimbotEnabled", false)
    local fov = optValue("FOVSize", 120)

    -- punkt celowania: pozycja myszy (przy zablokowanej myszy = środek ekranu)
    local aimPoint = UserInputService:GetMouseLocation()

    fovCircle.Visible = aimEnabled and togValue("FOVCircle", true)
    fovCircle.Radius = fov
    fovCircle.Position = aimPoint

    if not aimEnabled or not aimKeyHeld() then
        return
    end

    local part, screenPos = getClosestTarget(fov, aimPoint)
    if not part then
        return
    end

    local smooth = math.max(optValue("Smoothness", 5), 1)
    local method = optValue("AimMethod", "Camera")

    if method == "Mouse" and mousemoverel then
        local delta = (screenPos - aimPoint) / smooth
        mousemoverel(delta.X, delta.Y)
    else
        local desired = CFrame.lookAt(Camera.CFrame.Position, part.Position)

        -- Smoothness: 1 = natychmiast, im więcej tym wolniej
        local alpha = 1 - math.pow(1 - 1 / smooth, deltaTime * 60)

        Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(alpha, 0, 1))
    end
end

RunService:BindToRenderStep(
    "IgsmanHook_Aimbot",
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)
        local ok, err = pcall(aimbotStep, deltaTime)

        if not ok and not aimErrorShown then
            aimErrorShown = true
            warn("[IgsmanHook] Aimbot error: " .. tostring(err))
        end
    end
)

